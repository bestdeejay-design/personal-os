{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal OS",
  "version": "0.0.14",
  "identifier": "com.personalos.desktop",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bash scripts/copy-stack.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal OS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "url": "http://localhost:8080"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["stack/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
