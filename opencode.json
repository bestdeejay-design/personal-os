{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/deepseek-r1",
  "small_model": "ollama/qwen2.5-coder:7b",

  "provider": {
    "ollama": {
      "options": {
        "baseUrl": "http://localhost:11434"
      }
    }
  },

  "agent": {
    "build": {
      "model": "ollama/deepseek-r1",
      "mode": "primary",
      "description": "Основной агент (Sisyphus) для оркестрации"
    },
    "plan": {
      "model": "ollama/deepseek-r1",
      "mode": "subagent",
      "description": "Планировщик"
    },
    "explore": {
      "model": "ollama/yi-coder",
      "mode": "subagent",
      "description": "Поиск по кодовой базе"
    },
    "general": {
      "model": "ollama/qwen2.5-coder:7b",
      "mode": "subagent",
      "description": "Общий агент"
    }
  }
}
